rules_version = '2';

// ============================================================================
// 🔒 قواعد أمان Firebase Storage — منصة «طوبة» ⚽ (مشروع touba-3ds)
// ============================================================================
// 📝 HINT AR: كُتبت من الصفر لطوبة وفق «تصميم_الأساس.md» (القسم 7).
// كل رفع يجب أن يكون: مستخدماً مصادقاً + ملف صورة + حجم ضمن الحد.
// المسارات المعرّفة فقط مسموحة؛ ما عداها مرفوض بالقاعدة الافتراضية.
// ============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // ─── دوال مساعدة ─────────────────────────────────────────────────────

    // 📝 HINT AR: التحقق من أن الملف صورة (يمنع رفع ملفات تنفيذية/ضارة).
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // 📝 HINT AR: حد الحجم 2 ميغابايت — يجب أن يطابق حد الضغط في التطبيق.
    function isValidSize() {
      return request.resource.size < 2 * 1024 * 1024;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // 📝 HINT AR: الأدمن عبر Custom Claim أو role=='admin' في Firestore.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 📝 HINT AR: هل المستخدم الحالي كابتن هذا الفريق؟ (قراءة مستند الفريق من Firestore).
    function isTeamCaptain(teamId) {
      return isAuthenticated() &&
        firestore.get(/databases/(default)/documents/teams/$(teamId)).data.captainId == request.auth.uid;
    }

    // ─── صور البروفايل (الحساب الشخصي) ───────────────────────────────────
    // 📝 HINT AR: المسار موحَّد مع التطبيق: users/{uid}/profile/{file}.
    // الكتابة لصاحب الحساب فقط؛ القراءة عامة لعرض الأفاتار.
    match /users/{userId}/profile/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId
                   && isImage() && isValidSize();
    }

    // ─── شعارات الفرق ────────────────────────────────────────────────────
    // 📝 HINT AR: المسار: teams/{teamId}/logo/{file}. الكتابة لكابتن الفريق فقط.
    match /teams/{teamId}/logo/{fileName} {
      allow read: if true;
      allow write: if isImage() && isValidSize() && (isTeamCaptain(teamId) || isAdmin());
    }

    // ─── صور اللاعبين (البطاقات) ─────────────────────────────────────────
    // 📝 HINT AR: المسار: players/{playerId}/photo/{file}. يرفعها الكابتن أو
    // اللاعب صاحب السجل. للتبسيط وتجنّب قراءات متداخلة مكلفة نكتفي بمصادقة +
    // صورة + حجم؛ تشديد الملكية الدقيق يُضاف لاحقاً عبر Cloud Function.
    match /players/{playerId}/photo/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isValidSize();
    }

    // ─── شعارات/صور البطولات ─────────────────────────────────────────────
    // 📝 HINT AR: المسار: tournaments/{tId}/{file}. يرفعها منظّم/أدمن (مصادق + صورة + حجم).
    match /tournaments/{tId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isValidSize();
    }

    // ─── صور الإعلانات والأخبار (الرئيسية) ───────────────────────────────
    // 📝 HINT AR: المسار: banners/{id}/... و news/{id}/... — الكتابة للأدمن فقط.
    match /banners/{bannerId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isValidSize();
    }
    match /news/{newsId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && isValidSize();
    }

    // 📝 HINT AR: القاعدة الافتراضية — رفض أي مسار غير معرّف أعلاه.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
