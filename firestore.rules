rules_version = '2';

// ============================================================================
// 🔒 قواعد أمان Firestore — منصة «طوبة» ⚽ (مشروع touba-3ds)
// ============================================================================
// 📝 HINT AR: هذه القواعد كُتبت من الصفر لطوبة وفق وثيقة «تصميم_الأساس.md».
// المبدأ الذهبي: لا نثق بالواجهة أبداً — كل قاعدة تُفرض هنا على مستوى الخادم.
// جدار المصداقية: الإحصائيات والنتائج (stats / careerStats / standings /
// ratingPoints / resultConfirmed / statsApplied) لا تُكتب من العميل إطلاقاً،
// بل من Cloud Functions حصراً (Admin SDK يتجاوز هذه القواعد تلقائياً).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── دوال مساعدة (Helpers) ───────────────────────────────────────────

    // 📝 HINT AR: التحقق من تسجيل الدخول في Firebase Auth.
    function isAuthenticated() {
      return request.auth != null;
    }

    // 📝 HINT AR: التحقق من أن المستخدم هو صاحب المستند عبر معرّفه.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 📝 HINT AR: قراءة نوع المستخدم من Firestore (fallback عند غياب Custom Claims).
    function getUserType() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data.role : null;
    }

    // 📝 HINT AR: الأدمن — عبر Custom Claim (الأسرع) أو role=='admin' كبديل انتقالي.
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || getUserType() == 'admin');
    }

    // 📝 HINT AR: السوبر أدمن — Custom Claim فقط (للعمليات الأخطر).
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.superAdmin == true;
    }

    // 📝 HINT AR: صلاحية «منظّم بطولة» — Custom Claim organizer أو أدمن (C6).
    function isOrganizer() {
      return isAuthenticated() && (request.auth.token.organizer == true || isAdmin());
    }

    // 📝 HINT AR: صلاحية «حكم» — Custom Claim referee أو أدمن (C7، تُستخدم م3).
    function isReferee() {
      return isAuthenticated() && (request.auth.token.referee == true || isAdmin());
    }

    // 📝 HINT AR: هل المستخدم الحالي كابتن هذا الفريق؟ (قراءة مستند الفريق مرة).
    function isTeamCaptain(teamId) {
      let t = /databases/$(database)/documents/teams/$(teamId);
      return isAuthenticated() && exists(t) && get(t).data.captainId == request.auth.uid;
    }

    // 📝 HINT AR: هل المستخدم الحالي هو منظّم هذه البطولة؟
    function isTournamentOrganizer(tournamentId) {
      let tr = /databases/$(database)/documents/tournaments/$(tournamentId);
      return isAuthenticated() && exists(tr) && get(tr).data.organizerUid == request.auth.uid;
    }

    // 📝 HINT AR: هل التعديل يمسّ أياً من الحقول المحظورة على العميل؟
    function changes(allowedDiffKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedDiffKeys);
    }
    function touches(forbiddenKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(forbiddenKeys);
    }

    // ─── إعدادات النظام (وضع الصيانة / Feature Flags) ────────────────────
    // 📝 HINT AR: القراءة مفتوحة (يحمّلها التطبيق عند الإقلاع)، الكتابة للأدمن.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── المدن والمناطق (لاختيار الموقع) ─────────────────────────────────
    // 📝 HINT AR: قراءة عامة (قوائم الاختيار)، الكتابة للأدمن من لوحة التحكم.
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /districts/{districtId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── الإعلانات (Banners) — سلايدر الرئيسية ───────────────────────────
    // 📝 HINT AR: القراءة عامة، الكتابة (إنشاء/تعديل/حذف) للأدمن حصراً.
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── الأخبار (News) — الرئيسية ───────────────────────────────────────
    // 📝 HINT AR: القراءة عامة، الإنشاء/الحذف/تعديل المحتوى للأدمن. أي مستخدم
    // مسجّل يستطيع الإعجاب/المشاركة فقط (تعديل likes/shareCount لا غير).
    match /news/{newsId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isAuthenticated() && changes(['likes', 'shareCount']));
    }

    // ─── المستخدمون (الحسابات الشخصية) ───────────────────────────────────
    match /users/{userId} {
      // 📝 HINT AR: القراءة للمصادقين (لعرض الأسماء/التواصل). تحسين الخصوصية
      // (إخفاء الهاتف/البريد) يُؤجَّل عبر Cloud Functions أو وثيقة فرعية محمية.
      allow get, list: if isAuthenticated();

      // 📝 HINT AR: الإنشاء لصاحب الحساب فقط، ويُمنع تعيين دور أدمن ذاتياً.
      allow create: if isOwner(userId)
                    && request.resource.data.role in ['user', 'captain'];

      // 📝 HINT AR: التعديل لصاحبه (بلا تصعيد صلاحيات) أو للأدمن. المستخدم لا
      // يغيّر role / adminPermissions / linkedPlayerId / playerCode بنفسه
      // (playerCode هوية دائمة تُولَّد مرة عند الإنشاء، وlinkedPlayerId من CF).
      allow update: if isAdmin()
                    || (isOwner(userId)
                        && !touches(['role', 'adminPermissions',
                            'linkedPlayerId', 'playerCode']));

      allow delete: if isAdmin();
    }

    // ─── الفرق ───────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read: if true; // 📝 HINT AR: صفحات الفرق عامة للجميع.

      // 📝 HINT AR: المنشئ يصبح الكابتن، والحقول المحسوبة تبدأ بقيمها الافتراضية
      // (منع تزوير ratingPoints/stats عند الإنشاء).
      allow create: if isOwner(request.resource.data.captainId)
                    && request.resource.data.ratingPoints == 1200
                    && request.resource.data.stats.played == 0
                    && request.resource.data.stats.points == 0;

      // 📝 HINT AR: الكابتن يعدّل بيانات فريقه التعريفية فقط؛ الحقول المحسوبة
      // (ratingPoints / stats / badges) يكتبها النظام (CF) حصراً.
      allow update: if isAdmin()
                    || (isOwner(resource.data.captainId)
                        && !touches(['ratingPoints', 'stats', 'badges', 'captainId']));

      allow delete: if isOwner(resource.data.captainId) || isAdmin();
    }

    // ─── اللاعبون (سجلّات يديرها الكابتن) ────────────────────────────────
    match /players/{playerId} {
      allow read: if true; // 📝 HINT AR: بطاقات اللاعبين عامة.

      // 📝 HINT AR: ينشئه كابتن الفريق الحالي، والإحصائيات تبدأ صفراً.
      allow create: if isTeamCaptain(request.resource.data.currentTeamId)
                    && request.resource.data.careerStats.goals == 0
                    && request.resource.data.careerStats.matches == 0
                    && request.resource.data.claimedByUid == null;

      // 📝 HINT AR: ثلاثة مسارات للتعديل:
      // 1) الأدمن: بحرية.
      // 2) الكابتن: الحقول الكروية، بلا careerStats ولا claimedByUid.
      // 3) اللاعب صاحب السجل (بعد المطالبة): حقوله الشخصية فقط.
      allow update: if isAdmin()
                    || (isTeamCaptain(resource.data.currentTeamId)
                        && !touches(['careerStats', 'claimedByUid', 'teamToken']))
                    || (resource.data.claimedByUid == request.auth.uid
                        && changes(['name', 'photoUrl', 'preferredFoot',
                                    'height', 'weight', 'birthDate', 'updatedAt']));

      allow delete: if isAdmin() || isTeamCaptain(resource.data.currentTeamId);
    }

    // ─── طلبات الانضمام ──────────────────────────────────────────────────
    match /join_requests/{reqId} {
      // 📝 HINT AR: يقرؤها صاحب الطلب أو كابتن الفريق أو الأدمن.
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid
                      || isTeamCaptain(resource.data.teamId)
                      || isAdmin());

      // 📝 HINT AR: ينشئه اللاعب لنفسه بحالة pending فقط.
      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.status == 'pending';

      // 📝 HINT AR: القبول/الرفض بيد كابتن الفريق أو الأدمن.
      allow update: if isTeamCaptain(resource.data.teamId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── طلبات الخروج من الفريق (Release Requests) ───────────────────────
    // 📝 HINT AR: ينشئها اللاعب (userId==المستخدم)؛ يبتّها كابتن الفريق أو الأدمن
    // (status). التصعيد (escalated) يضبطه اللاعب صاحب الطلب. الفكّ الفعلي في CF.
    match /release_requests/{reqId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
                    || isTeamCaptain(resource.data.teamId)
                    || (resource.data.userId == request.auth.uid
                        && changes(['escalated']));
      allow delete: if isAdmin();
    }

    // ─── روابط دعوة المطالبة (Claim Invites) ─────────────────────────────
    // 📝 HINT AR: ينشئها كابتن فريق اللاعب؛ الاستخدام الفعلي (الربط) يتم عبر
    // Cloud Function `claimPlayerViaInvite` لضمان الذرّية والأمان — لذا لا
    // يُسمح بالتعديل/الحذف من العميل إطلاقاً.
    match /claim_invites/{inviteId} {
      allow read: if isAuthenticated();
      allow create: if isTeamCaptain(request.resource.data.teamId);
      allow update, delete: if false;
    }

    // ─── البطولات ────────────────────────────────────────────────────────
    match /tournaments/{tId} {
      allow read: if true; // 📝 HINT AR: صفحات البطولات والترتيب عامة.

      // 📝 HINT AR: الإنشاء لمن يملك صلاحية منظّم (يمنحها الأدمن — C6).
      allow create: if isOrganizer()
                    && request.resource.data.organizerUid == request.auth.uid;

      // 📝 HINT AR: التعديل لمنظّم البطولة أو الأدمن؛ الترتيب (standings) وحقول
      // الفائز (winnerTeamId/winnerTeamName) يكتبها النظام (CF) حصراً.
      allow update: if isAdmin()
                    || (resource.data.organizerUid == request.auth.uid
                        && !touches(['standings', 'organizerUid',
                            'winnerTeamId', 'winnerTeamName']));

      allow delete: if resource.data.organizerUid == request.auth.uid || isAdmin();
    }

    // ─── المباريات (top-level) ───────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if true; // 📝 HINT AR: المباريات والنتائج عامة.

      // 📝 HINT AR: ينشئها منظّم البطولة المعنية أو الأدمن.
      allow create: if isAdmin()
                    || isTournamentOrganizer(request.resource.data.tournamentId);

      // 📝 HINT AR: التعديل (النتيجة/الأحداث/التأكيد) لمنظّم البطولة أو الأدمن.
      // أعلام النظام (statsApplied / appliedSnapshot) لا تُكتب من العميل —
      // يضبطها CF عند تأكيد النتيجة (resultConfirmed=true).
      allow update: if (isAdmin() || isTournamentOrganizer(resource.data.tournamentId))
                    && !touches(['statsApplied', 'appliedSnapshot']);

      allow delete: if isAdmin() || isTournamentOrganizer(resource.data.tournamentId);
    }

    // ─── صفحات الحكّام (تُفعّل في المرحلة 3 — محجوزة الآن) ────────────────
    // 📝 HINT AR: الحكم = صلاحية على حساب عادي (C7). الصفحة عامة، والتقييم
    // (rating / matchesCount) يكتبه النظام (CF) من تقييمات ما بعد المباراة.
    match /refereeProfiles/{uid} {
      allow read: if true;
      allow create, update: if isAdmin()
                            || (isOwner(uid) && isReferee()
                                && !touches(['rating', 'matchesCount',
                                    'ratingCount', 'verified']));
      allow delete: if isAdmin();
    }

    // ─── طلبات التحكيم (Referee Applications) ────────────────────────────
    // 📝 HINT AR: يقدّمها أي مستخدم لنفسه (status=pending). يراجعها الأدمن وحده
    // (status). يقرؤها صاحبها أو منظّم البطولة أو الأدمن. المنح يتم عبر CF.
    match /referee_applications/{appId} {
      allow read: if isAuthenticated()
                  && (resource.data.userId == request.auth.uid
                      || resource.data.organizerUid == request.auth.uid
                      || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── تقييمات الحكّام (Referee Ratings) ───────────────────────────────
    // 📝 HINT AR: أي مستخدم مسجّل يقيّم الحكم بعد المباراة (1..5). مُعرّف المستند
    // = matchId_raterId يمنع التكرار. المتوسط يُجمَّع في refereeProfiles عبر CF.
    match /referee_ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
                    && request.resource.data.raterId == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow delete: if isAdmin();
    }

    // ─── الإشعارات ───────────────────────────────────────────────────────
    // 📝 HINT AR: كل مستخدم يتحكم بإشعاراته فقط؛ الإنشاء الجماعي عبر CF (Admin SDK).
    match /notifications/{notificationId} {
      allow get: if isAuthenticated()
                 && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.userId is string
                    && request.resource.data.keys().hasAll(['userId', 'title', 'body', 'type'])
                    && (isAdmin() || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAuthenticated()
                           && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── البلاغات (محتوى مخالف / صور غير لائقة) ──────────────────────────
    // 📝 HINT AR: أي مستخدم يبلّغ؛ القراءة/الإدارة للأدمن أو صاحب البلاغ.
    match /reports/{reportId} {
      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── المحادثات (كابتن↔كابتن في التحدي) — المرحلة 7 ───────────────────
    // 📝 HINT AR: محادثة بين طرفين فقط (participants). الطرفان يقرآن/يكتبان آخر
    // رسالة وعدّاد غير المقروء؛ لا أحد آخر. تغيير participants ممنوع.
    match /chats/{chatId} {
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants
                    && !touches(['participants']);
      allow delete: if false;

      // الرسائل: يقرؤها/يكتبها المشاركون فقط؛ المرسِل صاحب رسالته.
      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && request.auth.uid in get(
                      /databases/$(database)/documents/chats/$(chatId)
                    ).data.participants;
        allow create: if isAuthenticated()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(
                        /databases/$(database)/documents/chats/$(chatId)
                      ).data.participants;
        allow update, delete: if false;
      }
    }

    // ─── تحدّيات الفرق الودّية — المرحلة 7 ───────────────────────────────
    // 📝 HINT AR: القراءة للمسجّلين. الإنشاء لصاحب الطلب (كابتن). التحديث:
    // صاحب الطلب يدير كلّ شيء؛ أو متقدّم يضيف نفسه فقط (applicants/معرّفاته).
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.requesterCaptainId == request.auth.uid
                    && request.resource.data.status == 'open';
      allow update: if isAuthenticated() && (
                      isAdmin()
                      || resource.data.requesterCaptainId == request.auth.uid
                      || (
                        request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['applicants', 'applicantCaptainIds'])
                        && request.auth.uid in
                            request.resource.data.applicantCaptainIds
                      )
                    );
      allow delete: if isAuthenticated()
                    && (resource.data.requesterCaptainId == request.auth.uid
                        || isAdmin());
    }

    // 📝 HINT AR: قاعدة افتراضية صريحة — أي مسار غير معرّف أعلاه مرفوض تماماً.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
